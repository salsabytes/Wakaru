{
  "name": "wakaru",
  "version": "1.3.1",
  "description": "Wakaru (分かる) — a tiny WhatsApp bot that understands you. Built on Baileys + TypeScript.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node native/ensure-audio.mjs && node src/index.ts",
    "start:pairing": "node native/ensure-audio.mjs && node src/index.ts --use-pairing-code",
    "build:sticker": "bash native/build.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.7.6",
    "baileys": "^7.0.0-rc14",
    "pino": "^9.14.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  }
}
